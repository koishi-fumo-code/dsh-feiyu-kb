{
  "name": "dsh-feiyu-kb",
  "version": "0.7.3",
  "description": "DSH 插件：大肥鱼的大脑 —— 知识库 + 记忆库 + QQ 通道端点 + 设置页与输入框开关；附带 AstrBot 转发桥源码",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts",
    "bridge",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "examples"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "knowledge-base",
    "markdown",
    "bilibili",
    "notes"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koishi-fumo-code/dsh-feiyu-kb.git"
  },
  "homepage": "https://github.com/koishi-fumo-code/dsh-feiyu-kb#readme",
  "bugs": {
    "url": "https://github.com/koishi-fumo-code/dsh-feiyu-kb/issues"
  },
  "author": "koishi-fumo-code",
  "license": "MIT",
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "test": "node scripts/selftest.mjs",
    "bench": "node scripts/bench.mjs",
    "doctor": "node scripts/doctor.mjs",
    "compose": "node scripts/compose-check.mjs",
    "verify:chat": "node scripts/verify-p3.mjs",
    "verify:brain": "node scripts/verify-p4.mjs",
    "verify:observe": "node scripts/verify-p5.mjs",
    "rollback": "node scripts/rollback-merge.mjs",
    "bridge:install": "node scripts/install-bridge.mjs",
    "peers": "node scripts/install-peers.mjs"
  }
}
