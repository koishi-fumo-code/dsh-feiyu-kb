{
  "name": "dsh-feiyu-kb",
  "version": "0.3.1",
  "description": "DSH 插件：本地 Markdown 知识库 —— 设置页可改库位置与工具开关，支持视频/网页/文件/目录/RSS/随手记多种进料",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "knowledge-base",
    "markdown",
    "bilibili",
    "notes"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koishi-fumo-code/dsh-feiyu-kb.git"
  },
  "homepage": "https://github.com/koishi-fumo-code/dsh-feiyu-kb#readme",
  "bugs": {
    "url": "https://github.com/koishi-fumo-code/dsh-feiyu-kb/issues"
  },
  "author": "koishi-fumo-code",
  "license": "MIT"
}
