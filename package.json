{
  "name": "dsh-feiyu-kb",
  "version": "0.2.0",
  "description": "DSH 插件：把本地 Markdown 知识库暴露成工具（搜索/读取/写入/相关推荐），并支持网页、文件、目录、RSS、随手记等多种进料方式 —— 任何模型运行时都能用",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "knowledge-base",
    "markdown",
    "bilibili",
    "notes"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koishi-fumo-code/dsh-feiyu-kb.git"
  },
  "homepage": "https://github.com/koishi-fumo-code/dsh-feiyu-kb#readme",
  "bugs": {
    "url": "https://github.com/koishi-fumo-code/dsh-feiyu-kb/issues"
  },
  "author": "koishi-fumo-code",
  "license": "MIT"
}
